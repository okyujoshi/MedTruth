# Supabase（Hirono と同じ DB を使う場合は Hirono の .env をコピー可）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# 管理画面の削除・更新用（Supabase Dashboard → Settings → API の service_role key）
# SUPABASE_SERVICE_KEY=your-service-role-key

# トピック追加ページで「解説を自動生成」する場合（OpenAI）
# https://platform.openai.com/api-keys でキーを取得
# OPENAI_API_KEY=sk-...

# 寄付ページのリンク（任意）
# DONATE_KOFI_URL=https://ko-fi.com/your-username
# DONATE_PAYPAL_URL=https://www.paypal.com/donate?hosted_button_id=xxxxx

# 管理画面は hutz@nifty.com のみ利用可能
